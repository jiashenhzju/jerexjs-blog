---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TagBadge from "@/components/TagBadge.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import SplitView from "@/components/SplitView.astro";

export async function getStaticPaths() {
  const papers = await getCollection("papers");
  return papers.map((paper) => ({
    params: { id: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content, headings } = await render(paper);
const data = paper.data;

const dateStr = data.date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const updatedStr = data.updated?.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Resolve URLs for the split (compare) view.
//
// Strategy: self-host PDF.js viewer at /pdfjs/web/viewer.html and feed it the
// PDF URL via `?file=<encoded url>`. The viewer is same-origin (no
// X-Frame-Options issue), and PDF.js fetches the PDF via XHR. To pass the
// browser CORS check we fetch from `export.arxiv.org` which sets
// `Access-Control-Allow-Origin: *` (vs. `arxiv.org` which doesn't).
//
// Three URLs:
//   - embedUrl    : iframe src — points at our own viewer.html
//   - externalUrl : "open in new tab" target — canonical arxiv abs page
//   - pdfUrl     : raw PDF for the explicit "PDF" toolbar button
let embedUrl: string | undefined;
let externalUrl: string | undefined;
let pdfUrl: string | undefined;

const wrapInViewer = (rawPdfUrl: string) =>
  `${base}/pdfjs/web/viewer.html?file=${encodeURIComponent(rawPdfUrl)}`;

if (data.pdf) {
  if (/^https?:\/\//.test(data.pdf)) {
    pdfUrl = data.pdf;
    embedUrl = wrapInViewer(data.pdf);
    externalUrl = data.pdf;
  } else {
    const clean = data.pdf.replace(/^\.?\//, "");
    pdfUrl = `${base}/${clean}`;
    embedUrl = pdfUrl;
    externalUrl = pdfUrl;
  }
}

if (data.arxiv) {
  const arxivId = data.arxiv
    .replace(/^https?:\/\/(?:www\.)?arxiv\.org\/(?:abs|pdf|html)\//, "")
    .replace(/\.pdf$/, "")
    .replace(/v\d+$/, "");
  if (arxivId) {
    if (!pdfUrl) pdfUrl = `https://arxiv.org/pdf/${arxivId}.pdf`;
    if (!embedUrl) {
      // NOTE: Do NOT append `.pdf` here. `export.arxiv.org/pdf/<id>.pdf` 302's
      // to `export.arxiv.org/pdf/<id>`, and the redirect response itself lacks
      // CORS headers, so cross-origin fetch (PDF.js) bails on the whole chain.
      // The trailing-slash form returns the PDF directly with proper CORS.
      const corsPdf = `https://export.arxiv.org/pdf/${arxivId}`;
      embedUrl = wrapInViewer(corsPdf);
    }
    if (!externalUrl) externalUrl = `https://arxiv.org/abs/${arxivId}`;
  }
}

const canSplit = Boolean(embedUrl);
---

<BaseLayout
  title={data.title}
  description={data.summary ?? `Paper notes on ${data.title}`}
>
  <div id="paper-shell" class="paper-shell" data-split-mode="off">
    <article class="paper-content max-w-6xl mx-auto px-5 lg:px-8 pt-10 pb-16">
      <a
        href={`${base}/`}
        class="inline-flex items-center gap-1.5 text-sm text-ink-50 hover:text-accent-400 transition-colors mb-6"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-4 h-4">
          <path d="M19 12H5" /><path d="m12 19-7-7 7-7" />
        </svg>
        All papers
      </a>

      <header class="mb-8 pb-6 border-b border-paper-200">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div class="flex flex-wrap items-center gap-2">
            {data.tags.map((tag) => <TagBadge tag={tag} />)}
          </div>

          {canSplit && (
            <button
              id="split-toggle"
              type="button"
              class="hidden lg:inline-flex shrink-0 items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium border border-accent-200 bg-accent-50 text-accent-500 hover:bg-accent-100 transition-colors"
              title="左右对照阅读：右侧是笔记，左侧是原文 PDF"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-3.5 h-3.5" aria-hidden="true">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                <polyline points="14 3 14 8 19 8" />
              </svg>
              <span>读原文</span>
            </button>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink-300 leading-tight">
          {data.title}
        </h1>
        {data.titleZh && (
          <p class="text-lg text-ink-100 mt-2">{data.titleZh}</p>
        )}

        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-ink-50 font-mono">
          <span>{dateStr}</span>
          {updatedStr && <span>· updated {updatedStr}</span>}
          {data.venue && <span>· {data.venue}{data.year ? ` ${data.year}` : ""}</span>}
          {!data.venue && data.year && <span>· {data.year}</span>}
          {data.rating !== undefined && (
            <span class="text-accent-400">
              {"★".repeat(Math.round(data.rating))}<span class="text-paper-300">{"★".repeat(5 - Math.round(data.rating))}</span>
            </span>
          )}
        </div>

        {data.authors && data.authors.length > 0 && (
          <p class="mt-3 text-sm text-ink-100">
            <span class="font-mono text-xs uppercase text-ink-50 mr-2">authors</span>
            {data.authors.join(", ")}
          </p>
        )}
        {data.affiliations && data.affiliations.length > 0 && (
          <p class="mt-1 text-sm text-ink-50">
            <span class="font-mono text-xs uppercase mr-2">affiliations</span>
            {data.affiliations.join(" · ")}
          </p>
        )}

        <div class="mt-4 flex flex-wrap gap-2">
          {data.arxiv && (
            <a
              href={data.arxiv.startsWith("http") ? data.arxiv : `https://arxiv.org/abs/${data.arxiv}`}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-medium bg-accent-50 text-accent-500 border border-accent-100 hover:bg-accent-100 transition-colors"
            >
              arXiv ↗
            </a>
          )}
          {data.projectPage && (
            <a
              href={data.projectPage}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-medium bg-paper-100 text-ink-100 border border-paper-200 hover:border-accent-200 transition-colors"
            >
              project page ↗
            </a>
          )}
          {data.github && (
            <a
              href={data.github}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-medium bg-paper-100 text-ink-100 border border-paper-200 hover:border-accent-200 transition-colors"
            >
              github ↗
            </a>
          )}
          {data.huggingface && (
            <a
              href={data.huggingface}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-medium bg-paper-100 text-ink-100 border border-paper-200 hover:border-accent-200 transition-colors"
            >
              🤗 huggingface ↗
            </a>
          )}
        </div>
      </header>

      <div class="paper-body grid grid-cols-1 xl:grid-cols-[1fr_14rem] gap-10">
        <div class="prose-paper max-w-prose">
          <Content />
        </div>
        <TableOfContents headings={headings} />
      </div>
    </article>

    {canSplit && embedUrl && (
      <SplitView
        embedUrl={embedUrl}
        externalUrl={externalUrl ?? embedUrl}
        pdfUrl={pdfUrl}
        label={data.title}
      />
    )}
  </div>
</BaseLayout>

<script is:inline>
  // Add anchor "#" links to h2/h3
  document.querySelectorAll(".prose-paper h2, .prose-paper h3").forEach((h) => {
    if (!h.id) return;
    const a = document.createElement("a");
    a.className = "heading-anchor";
    a.href = `#${h.id}`;
    a.textContent = "#";
    a.setAttribute("aria-label", "Permalink");
    h.appendChild(a);
  });
</script>

<script is:inline>
  // ============== Split-view controller (single-source, simple) ==============
  (() => {
    const shell = document.getElementById("paper-shell");
    if (!shell) return;
    const toggleBtn = document.getElementById("split-toggle");
    const closeBtn = document.getElementById("split-close");
    const iframe = document.getElementById("split-iframe");
    const fallbackBox = document.getElementById("split-frame-fallback");
    if (!toggleBtn || !iframe) return;

    const mqDesktop = window.matchMedia("(min-width: 1024px)");

    const setMode = (on) => {
      shell.dataset.splitMode = on ? "on" : "off";
      const aside = shell.querySelector(".split-pane");
      if (aside) aside.setAttribute("aria-hidden", on ? "false" : "true");
      try {
        const url = new URL(window.location.href);
        if (on) url.hash = "split"; else if (url.hash === "#split") url.hash = "";
        history.replaceState(null, "", url.toString());
      } catch {}

      // Fallback safety: if `load` never fires within 8s after first reveal, show
      // fallback. Self-hosted PDF.js viewer's `load` typically fires once viewer.html
      // is parsed (well under 1s), even before the actual PDF starts streaming, so 8s
      // is a generous safety net for slow networks / CDN cold starts.
      if (on && !iframe.dataset.watched) {
        iframe.dataset.watched = "1";
        let settled = false;
        iframe.addEventListener("load", () => { settled = true; }, { once: true });
        window.setTimeout(() => {
          if (!settled && fallbackBox) fallbackBox.classList.add("is-active");
        }, 8000);
      }
    };

    toggleBtn.addEventListener("click", () => {
      if (!mqDesktop.matches) return;
      setMode(true);
    });
    if (closeBtn) closeBtn.addEventListener("click", () => setMode(false));

    if (window.location.hash === "#split" && mqDesktop.matches) setMode(true);

    mqDesktop.addEventListener("change", (e) => {
      if (!e.matches && shell.dataset.splitMode === "on") setMode(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && shell.dataset.splitMode === "on") setMode(false);
    });
  })();
</script>
