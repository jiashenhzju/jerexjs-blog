---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PaperCard from "@/components/PaperCard.astro";
import TagBadge from "@/components/TagBadge.astro";
import SearchBox from "@/components/SearchBox.astro";

const papers = (await getCollection("papers"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tagCount = new Map<string, number>();
papers.forEach((p) =>
  p.data.tags.forEach((t) => tagCount.set(t, (tagCount.get(t) ?? 0) + 1)),
);
const allTags = Array.from(tagCount.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout>
  <section class="research-hero">
    <div class="research-hero-grid" aria-hidden="true"></div>
    <p class="research-eyebrow">JEREX / WORKING NOTES / 2026</p>
    <h1>Reading intelligent<br />systems, closely.</h1>
    <div class="research-hero-lower">
      <p>
        Bilingual paper notes, implementation details, and independent
        judgments on multimodal models, agents, and world modeling.
      </p>
      <dl class="research-stats">
        <div><dt>Papers</dt><dd>{String(papers.length).padStart(2, "0")}</dd></div>
        <div><dt>Topics</dt><dd>{String(allTags.length).padStart(2, "0")}</dd></div>
      </dl>
    </div>
  </section>

  <section class="research-index">
    <header class="research-index-header">
      <div>
        <p class="research-section-code">INDEX / {String(papers.length).padStart(2, "0")}</p>
        <h2>Paper notes</h2>
      </div>
      <SearchBox />
    </header>

    {allTags.length > 0 && (
      <div class="research-tag-strip">
        {allTags.map(([tag, count]) => <TagBadge tag={tag} count={count} />)}
      </div>
    )}

    {papers.length === 0 ? (
      <div class="research-empty">
        <span>00</span>
        <p>Index is clear. The next reading starts here.</p>
        <p class="research-empty-path">
          Add Markdown to <code>src/content/papers/</code>
        </p>
      </div>
    ) : (
      <div class="research-list-wrap">
        <div id="paper-grid" class="research-list">
          {papers.map((p, index) => (
            <div
              data-paper-card
              data-haystack={[
                p.data.title,
                p.data.titleZh,
                ...(p.data.authors ?? []),
                ...(p.data.tags ?? []),
                p.data.summary,
              ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase()}
            >
              <PaperCard
                id={p.id}
                title={p.data.title}
                titleZh={p.data.titleZh}
                date={p.data.date}
                summary={p.data.summary}
                tags={p.data.tags}
                status={p.data.status}
                rating={p.data.rating}
                venue={p.data.venue}
                year={p.data.year}
                authors={p.data.authors}
                index={index + 1}
              />
            </div>
          ))}
        </div>
        <div id="empty-state" class="research-empty hidden">
          <span>∅</span><p>No matching paper.</p>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
