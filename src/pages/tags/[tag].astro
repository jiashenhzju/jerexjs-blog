---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PaperCard from "@/components/PaperCard.astro";

export async function getStaticPaths() {
  const papers = (await getCollection("papers")).filter((p) => !p.data.draft);
  const tagSet = new Set<string>();
  papers.forEach((p) => p.data.tags.forEach((t) => tagSet.add(t)));

  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: {
      tag,
      papers: papers
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag, papers } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={`#${tag}`}>
  <section class="max-w-5xl mx-auto px-5 lg:px-8 pt-10 pb-16">
    <a
      href={`${base}/tags`}
      class="inline-flex items-center gap-1 text-sm text-ink-50 hover:text-accent-400 transition-colors mb-3"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-3.5 h-3.5">
        <path d="M19 12H5" /><path d="m12 19-7-7 7-7" />
      </svg>
      Tags
    </a>

    <h1 class="text-xl font-semibold text-ink-300 tracking-tight flex items-center gap-2">
      <span class="text-accent-400">#</span>{tag}
      <span class="text-sm font-mono text-ink-50">{papers.length}</span>
    </h1>

    <div class="mt-6 grid gap-4">
      {papers.map((p) => (
        <PaperCard
          id={p.id}
          title={p.data.title}
          titleZh={p.data.titleZh}
          date={p.data.date}
          summary={p.data.summary}
          tags={p.data.tags}
          status={p.data.status}
          rating={p.data.rating}
          venue={p.data.venue}
          year={p.data.year}
          authors={p.data.authors}
        />
      ))}
    </div>
  </section>
</BaseLayout>
