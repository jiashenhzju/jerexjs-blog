---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";

const isActive = (href: string) => {
  if (href === "/") return path === "/" || path === "";
  return path.startsWith(href);
};

const link = (href: string) => `${base}${href}`;
---

<header class="site-header">
  <div class="site-header-inner">
    <a
      href={link("/")}
      class="site-brand"
      aria-label="Jerex Research Index"
    >
      <span class="site-brand-mark">JX</span>
      <span class="site-brand-copy">
        <strong>Research Index</strong>
        <small>notes on intelligent systems</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <a href={link("/")} class={`nav-link ${isActive("/") ? "nav-link-active" : ""}`}>Index</a>
      <a href={link("/tags")} class={`nav-link ${isActive("/tags") ? "nav-link-active" : ""}`}>Topics</a>
      <a href={link("/rss.xml")} class="nav-link">RSS</a>
    </nav>
  </div>
</header>
