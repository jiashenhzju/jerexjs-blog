---
import TagBadge from "@/components/TagBadge.astro";

interface Props {
  id: string;
  title: string;
  titleZh?: string;
  date: Date;
  summary?: string;
  tags: string[];
  status?: string;
  rating?: number;
  venue?: string;
  year?: string | number;
  authors?: string[];
}

const {
  id,
  title,
  titleZh,
  date,
  summary,
  tags,
  status,
  rating,
  venue,
  year,
  authors = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = `${base}/papers/${id}`;

const dateStr = date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

const statusMap: Record<string, { label: string; color: string }> = {
  done: { label: "已读", color: "bg-moss-400/15 text-moss-500 border-moss-400/30" },
  reading: { label: "在读", color: "bg-accent-50 text-accent-500 border-accent-200" },
  skimmed: { label: "略读", color: "bg-paper-100 text-ink-50 border-paper-300" },
  draft: { label: "草稿", color: "bg-paper-100 text-ink-50 border-paper-300" },
};
const st = status ? statusMap[status] : undefined;

const authorPreview =
  authors.length === 0
    ? null
    : authors.length <= 3
      ? authors.join(", ")
      : `${authors.slice(0, 2).join(", ")} et al.`;
---

<article class="card group">
  <div class="flex items-start justify-between gap-4 mb-2">
    <div class="flex-1 min-w-0">
      <a href={href} class="block">
        <h2 class="text-lg font-semibold text-ink-300 group-hover:text-accent-400 transition-colors leading-snug">
          {title}
        </h2>
        {titleZh && (
          <p class="text-sm text-ink-50 mt-0.5">{titleZh}</p>
        )}
      </a>
    </div>

    {st && (
      <span class={`shrink-0 inline-flex items-center text-[11px] font-medium px-2 py-0.5 rounded-full border ${st.color}`}>
        {st.label}
      </span>
    )}
  </div>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-50 font-mono mb-3">
    <span>{dateStr}</span>
    {venue && <><span>·</span><span>{venue}{year ? ` ${year}` : ""}</span></>}
    {!venue && year && <><span>·</span><span>{year}</span></>}
    {authorPreview && <><span>·</span><span class="truncate max-w-[18rem]">{authorPreview}</span></>}
    {rating !== undefined && (
      <>
        <span>·</span>
        <span class="text-accent-400">
          {"★".repeat(Math.round(rating))}<span class="text-paper-300">{"★".repeat(5 - Math.round(rating))}</span>
        </span>
      </>
    )}
  </div>

  {summary && (
    <p class="text-sm text-ink-100 leading-relaxed mb-3 line-clamp-3">
      {summary}
    </p>
  )}

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => <TagBadge tag={tag} />)}
    </div>
  )}
</article>
