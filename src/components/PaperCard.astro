---
import TagBadge from "@/components/TagBadge.astro";

interface Props {
  id: string;
  title: string;
  titleZh?: string;
  date: Date;
  summary?: string;
  tags: string[];
  status?: string;
  rating?: number;
  venue?: string;
  year?: string | number;
  authors?: string[];
  index?: number;
}

const {
  id,
  title,
  titleZh,
  date,
  summary,
  tags,
  status,
  rating,
  venue,
  year,
  authors = [],
  index,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = `${base}/papers/${id}`;

const dateStr = date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

const statusMap: Record<string, { label: string; color: string }> = {
  done: { label: "已读", color: "bg-moss-400/15 text-moss-500 border-moss-400/30" },
  reading: { label: "在读", color: "bg-accent-50 text-accent-500 border-accent-200" },
  skimmed: { label: "略读", color: "bg-paper-100 text-ink-50 border-paper-300" },
  draft: { label: "草稿", color: "bg-paper-100 text-ink-50 border-paper-300" },
};
const st = status ? statusMap[status] : undefined;

const authorPreview =
  authors.length === 0
    ? null
    : authors.length <= 3
      ? authors.join(", ")
      : `${authors.slice(0, 2).join(", ")} et al.`;
---

<article class="paper-row group">
  <div class="paper-row-index" aria-hidden="true">
    {String(index ?? 1).padStart(2, "0")}
  </div>
  <div class="paper-row-main">
    <div class="paper-row-heading">
      <div class="min-w-0">
      <a href={href} class="block">
        <h2 class="paper-row-title">
          {title}
        </h2>
        {titleZh && (
          <p class="paper-row-title-zh">{titleZh}</p>
        )}
      </a>
      </div>

      {st && <span class="paper-row-status">{st.label}</span>}
    </div>

    <div class="paper-row-meta">
      <span>{dateStr}</span>
      {venue && <span>{venue}{year ? ` ${year}` : ""}</span>}
      {!venue && year && <span>{year}</span>}
      {authorPreview && <span class="truncate">{authorPreview}</span>}
    {rating !== undefined && (
        <span class="paper-row-rating">
          {"★".repeat(Math.round(rating))}<span class="text-paper-300">{"★".repeat(5 - Math.round(rating))}</span>
        </span>
    )}
    </div>

    {summary && <p class="paper-row-summary">{summary}</p>}

    {tags.length > 0 && (
      <div class="paper-row-tags">{tags.map((tag) => <TagBadge tag={tag} />)}</div>
    )}
  </div>
  <a href={href} class="paper-row-arrow" aria-label={`Read ${title}`}>↗</a>
</article>
